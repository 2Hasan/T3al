# Copy to .env on the server (Plesk file manager or SSH) and fill in the blanks.
# Never commit the real .env. Run `php artisan key:generate --show` once for APP_KEY.
APP_NAME=T3al
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://7assan.dev
APP_LOCALE=ar
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=error

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

# One host per surface. Marketing is the apex, the shop panel and admin get their own subdomains.
T3AL_MARKETING_DOMAIN=7assan.dev
T3AL_PANEL_DOMAIN=panel.7assan.dev
T3AL_ADMIN_DOMAIN=admin.7assan.dev
T3AL_SUPPORT_WHATSAPP=

MAIL_MAILER=log

# Apple Wallet and Google Wallet stay empty until the Apple Developer account and Google Wallet issuer exist.
MOBILE_PASS_APPLE_ORGANIZATION_NAME="T3al"
MOBILE_PASS_APPLE_TYPE_IDENTIFIER=
MOBILE_PASS_APPLE_TEAM_IDENTIFIER=
MOBILE_PASS_APPLE_CERTIFICATE_PATH=
MOBILE_PASS_APPLE_CERTIFICATE_PASSWORD=
MOBILE_PASS_APPLE_WEBSERVICE_SECRET=
MOBILE_PASS_GOOGLE_ISSUER_ID=
MOBILE_PASS_GOOGLE_KEY_PATH=
