APP_NAME=T3al
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=t3al
DB_USERNAME=t3al
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# T3al surfaces. Leave empty for local development (served on paths: /app, /admin).
T3AL_MARKETING_DOMAIN=
T3AL_PANEL_DOMAIN=
T3AL_ADMIN_DOMAIN=
T3AL_SUPPORT_WHATSAPP=

# Apple Wallet and Google Wallet (see docs in vendor/spatie/laravel-mobile-pass)
MOBILE_PASS_APPLE_ORGANIZATION_NAME="T3al"
MOBILE_PASS_APPLE_TYPE_IDENTIFIER=
MOBILE_PASS_APPLE_TEAM_IDENTIFIER=
MOBILE_PASS_APPLE_CERTIFICATE_PATH=
MOBILE_PASS_APPLE_CERTIFICATE_PASSWORD=
MOBILE_PASS_APPLE_WEBSERVICE_SECRET=
MOBILE_PASS_GOOGLE_ISSUER_ID=
MOBILE_PASS_GOOGLE_KEY_PATH=
